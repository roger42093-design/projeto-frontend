# =====================================================================
# Variaveis de ambiente do front-end (Vite)
#
# Como usar:
#   1. Copie este arquivo para ".env"   ->   cp .env.example .env
#   2. Preencha os valores reais no .env (o .env NAO vai para o Git)
#   3. Reinicie o "npm run dev" sempre que mudar o .env
#
# Regras do formato .env:
#   - uma variavel por linha: NOME=valor
#   - sem virgula no final da linha
#   - so variaveis que comecam com VITE_ ficam visiveis no navegador.
#     Nunca coloque senhas aqui.
#
# Modos (ver package.json): o arquivo do modo tem prioridade sobre o .env
#   npm run dev / dev:local  -> .env + .env.dev-local
#   npm run dev:remoto       -> .env + .env.dev-remoto
#   npm run build            -> .env + .env.production
# No Docker/GitHub Actions os valores vem dos --build-arg (ver Dockerfile).
# =====================================================================

# Endereco do back-end (Spring Boot), sem barra no final.
# Usado por src/utils/api.js e src/pages/cadastro/Cadastro.jsx
VITE_API_URL=http://localhost:8080

# Firebase - Console Firebase > Configuracoes do projeto > Geral > Config do SDK
# Usado por src/firebase.js e por scripts/generate-firebase-sw.js
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave publica de push - Configuracoes do projeto > Cloud Messaging > Certificados Web Push
VITE_FIREBASE_VAPID_KEY=